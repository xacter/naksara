{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naksara",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naksara-db",
      "database_id": "b2ecdb49-35c6-4fd5-a62e-1c9ad8b848f9",
      "migrations_dir": "migrations"
    }
  ],
  // Günlük bakım (eski sürümleri temizleme) — 02:17 İstanbul
  "triggers": { "crons": ["17 23 * * *"] },
  "observability": { "enabled": true }
}
